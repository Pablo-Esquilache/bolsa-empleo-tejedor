# Configuración pública de Supabase (Frontend)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Nombre de la aplicación y remitente de correos
VITE_APP_NAME="Bolsa de Empleo Tejedor"

# Variables exclusivas de servidor / Edge Functions / Netlify (NUNCA con prefijo VITE_)
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER_NAME="Bolsa de Empleo Tejedor"
# BREVO_SENDER_EMAIL="tu-correo-verificado@dominio.com"
